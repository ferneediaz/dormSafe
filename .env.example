# Copy to .env to override defaults.

# frozen = bundled real snapshot (default, deterministic) | live = official sources, cached, frozen fallback
DORMSAFE_EXTERNAL_DATA_MODE=frozen
DORMSAFE_CACHE_TTL_SECONDS=300
DORMSAFE_NCDR_MAX_CAP_DOCS=10
DORMSAFE_SHELTER_RADIUS_KM=5

# Demo dorm (fictional)
DORMSAFE_DORM_NAME=DormSafe Demo Dorm A (simulated)
DORMSAFE_DORM_LATITUDE=25.0174
DORMSAFE_DORM_LONGITUDE=121.5405
DORMSAFE_DORM_FLOOR_COUNT=8
DORMSAFE_DORM_ROOMS_PER_FLOOR=6
DORMSAFE_DORM_RESIDENTS_PER_ROOM=2

# Pre-load the demo scenario (fire, blocked stairwell, resident needing help)
DORMSAFE_SEED_SCENARIO=false
